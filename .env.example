# Google Maps JavaScript API — required for Real-Time AQI Map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — defaults shown in lib/config/env.ts
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_APP_NAME=Atovio BeyondAQI Web

# ── Shopify blog (Storefront API) ────────────────────────────────────────────
# Server-only — no NEXT_PUBLIC_ prefix, so the token stays out of the browser bundle.
# Shopify admin → Settings → Apps and sales channels → Develop apps → your app
#   • Configuration → Storefront API → enable scope: unauthenticated_read_content
#   • API credentials → copy the "Storefront API access token"
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional — defaults shown in lib/config/shopify.ts
# SHOPIFY_API_VERSION=2025-01
# Blog handle from Content → Blog posts → Manage blogs. Leave blank to read all blogs.
# SHOPIFY_BLOG_HANDLE=news

# Public origin — used for sitemap.xml / robots.txt absolute URLs.
# Must match the real production domain.
NEXT_PUBLIC_SITE_URL=https://beyondaqi.atovio.in
